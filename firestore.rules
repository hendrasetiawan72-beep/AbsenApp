rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Health check & connection validation
    match /test/{docId} {
      allow read: if true;
    }

    // Teacher workspaces (isolated cross-device sync)
    match /teacher_workspaces/{teacherUid} {
      allow read, write: if isSignedIn() && request.auth.uid == teacherUid;
    }

    // User-isolated collections: users/{userId}/...
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;

      match /{allPaths=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Root collections with teacherUid check
    match /classes/{classId} {
      allow get, list, delete: if isSignedIn() && resource.data.teacherUid == request.auth.uid;
      allow create, update: if isSignedIn() && (request.resource.data.teacherUid == request.auth.uid || (resource != null && resource.data.teacherUid == request.auth.uid));
    }

    match /attendance_sessions/{sessionId} {
      allow get, list, delete: if isSignedIn() && resource.data.teacherUid == request.auth.uid;
      allow create, update: if isSignedIn() && (request.resource.data.teacherUid == request.auth.uid || (resource != null && resource.data.teacherUid == request.auth.uid));
    }

    match /students/{studentId} {
      allow get, list, delete: if isSignedIn() && resource.data.teacherUid == request.auth.uid;
      allow create, update: if isSignedIn() && (request.resource.data.teacherUid == request.auth.uid || (resource != null && resource.data.teacherUid == request.auth.uid));
    }

    match /grades/{gradeId} {
      allow get, list, delete: if isSignedIn() && resource.data.teacherUid == request.auth.uid;
      allow create, update: if isSignedIn() && (request.resource.data.teacherUid == request.auth.uid || (resource != null && resource.data.teacherUid == request.auth.uid));
    }

    match /teaching_agendas/{agendaId} {
      allow get, list, delete: if isSignedIn() && resource.data.teacherUid == request.auth.uid;
      allow create, update: if isSignedIn() && (request.resource.data.teacherUid == request.auth.uid || (resource != null && resource.data.teacherUid == request.auth.uid));
    }
  }
}

