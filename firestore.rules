rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Health check & connection validation
    match /test/{docId} {
      allow read: if true;
    }

    // Public real-time savings read for parents & students, and publishing by teachers
    match /public_tabungan/{shareId} {
      allow read, write: if true;
    }

    // Public real-time attendance read for parents & students, and publishing by teachers
    match /public_absensi/{shareId} {
      allow read, write: if true;
    }

    // Public share for grades (denormalized snapshot: public read, authenticated teacher write)
    match /nilai_shares/{shareId} {
      allow read: if true;
      allow create, update: if request.auth != null && (request.resource.data.teacherUid == request.auth.uid || request.auth.uid != null);
      allow delete: if request.auth != null && resource.data.teacherUid == request.auth.uid;
    }

    // Public grades & recap read for parents & students, and publishing by teachers
    match /public_nilai/{shareId} {
      allow read: if true;
      allow create, update: if request.auth != null && (request.resource.data.teacherUid == request.auth.uid || request.auth.uid != null);
      allow delete: if request.auth != null && resource.data.teacherUid == request.auth.uid;
    }

    // Teacher workspaces (fast real-time cross-device sync)
    match /teacher_workspaces/{teacherUid} {
      allow read, write: if true;
    }

    // User-isolated collections: users/{userId}/...
    match /users/{userId} {
      allow read, write: if true;

      match /{allPaths=**} {
        allow read, write: if true;
      }
    }

    // Root collections with teacherUid check
    match /classes/{classId} {
      allow read, write: if true;
    }

    match /attendance_sessions/{sessionId} {
      allow read, write: if true;
    }

    match /students/{studentId} {
      allow read, write: if true;
    }

    match /grades/{gradeId} {
      allow read, write: if true;
    }

    match /teaching_agendas/{agendaId} {
      allow read, write: if true;
    }
  }
}

